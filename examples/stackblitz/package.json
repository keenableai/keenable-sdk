{
  "name": "keenable-quickstart",
  "private": true,
  "version": "0.0.0",
  "description": "Keyless Keenable web search from TypeScript. Runs on StackBlitz with nothing installed.",
  "type": "module",
  "scripts": {
    "start": "tsx index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "keenable": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "stackblitz": {
    "installDependencies": true,
    "startCommand": "npm start"
  }
}
