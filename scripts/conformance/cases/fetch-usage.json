{
  "_comment": "POST /v1/fetch (retries off) for `urls`, and the usage fetch() returns. `json` is sent as its JSON text. expect.usage is the call-level usage (FetchResponse.usage), expect.pages each page's own usage (deprecated; only an older server sends it), one per result entry, in order. The body's usage is read as in responses. When it is not an object (an older server, which bills each page on its own), the call-level usage is built from the pages' usage: each page's items are merged in order of first appearance by sku, price amount and price currency, adding their quantities; total is the exact sum of the pages' totals with the first page's total currency; balance is the last page's balance that is not null; the deprecated old fields are \"\", 0, 0, false and null. No usage anywhere is null. See scripts/conformance/README.md under Usage.",
  "cases": [
    {"name": "the standard usage object (backend #951) is the call's; pages carry none", "urls": ["https://example.com/a", "https://example.com/b"], "json": {"results": [{"url": "https://example.com/a", "title": "T", "content": "C"}, {"url": "https://example.com/b", "title": "T", "content": "C"}], "usage": {"items": [{"sku": "fetch.live", "quantity": 2, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.004", "currency": "usd"}, "balance": {"amount": "9.996", "currency": "usd"}}}, "expect": {"usage": {"items": [{"sku": "fetch.live", "quantity": 2, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.004", "currency": "usd"}, "balance": {"amount": "9.996", "currency": "usd"}, "sku": "", "amount": 0, "credits": 0, "paid": false, "credits_remaining": null}, "pages": [null, null]}},
    {"name": "today's server: the call's usage is built from each page's", "urls": ["https://example.com/a", "https://example.com/b", "https://example.com/c"], "json": {"results": [{"url": "https://example.com/a", "title": "T", "content": "C", "usage": {"sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": 0.002, "amount_decimal": "0.002", "currency": "usd"}, "balance": {"amount": 9.998, "amount_decimal": "9.998", "currency": "usd"}}}, {"url": "https://example.com/b", "title": "T", "content": "C", "usage": {"sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": 0.002, "amount_decimal": "0.002", "currency": "usd"}, "balance": {"amount": 9.996, "amount_decimal": "9.996", "currency": "usd"}}}, {"url": "https://example.com/c", "error": {"status": 404, "error": "Not found"}}]}, "expect": {"usage": {"items": [{"sku": "fetch.live", "quantity": 2, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.004", "currency": "usd"}, "balance": {"amount": "9.996", "currency": "usd"}, "sku": "", "amount": 0, "credits": 0, "paid": false, "credits_remaining": null}, "pages": [{"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.002", "currency": "usd"}, "balance": {"amount": "9.998", "currency": "usd"}, "sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}, {"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.002", "currency": "usd"}, "balance": {"amount": "9.996", "currency": "usd"}, "sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}, null]}},
    {"name": "pages with different skus and prices stay separate items; balance is the last page's that has one", "urls": ["https://example.com/a", "https://example.com/b", "https://example.com/c"], "json": {"results": [{"url": "https://example.com/a", "title": "T", "content": "C", "usage": {"sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": "0.002", "currency": "usd"}}}, {"url": "https://example.com/b", "title": "T", "content": "C", "usage": {"sku": "fetch.cached", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": "0.001", "currency": "usd"}, "balance": {"amount": "5.5", "currency": "usd"}}}, {"url": "https://example.com/c", "title": "T", "content": "C", "usage": {"sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": "0.002", "currency": "usd"}}}]}, "expect": {"usage": {"items": [{"sku": "fetch.live", "quantity": 2, "price": {"amount": "0.002", "currency": "usd"}}, {"sku": "fetch.cached", "quantity": 1, "price": {"amount": "0.001", "currency": "usd"}}], "total": {"amount": "0.005", "currency": "usd"}, "balance": {"amount": "5.5", "currency": "usd"}, "sku": "", "amount": 0, "credits": 0, "paid": false, "credits_remaining": null}, "pages": [{"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.002", "currency": "usd"}, "balance": null, "sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}, {"items": [{"sku": "fetch.cached", "quantity": 1, "price": {"amount": "0.001", "currency": "usd"}}], "total": {"amount": "0.001", "currency": "usd"}, "balance": {"amount": "5.5", "currency": "usd"}, "sku": "fetch.cached", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}, {"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.002", "currency": "usd"}, "balance": null, "sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}]}},
    {"name": "the built total is an exact sum", "urls": ["https://example.com/a", "https://example.com/b", "https://example.com/c"], "json": {"results": [{"url": "https://example.com/a", "title": "T", "content": "C", "usage": {"sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": 0.1, "currency": "usd"}}}, {"url": "https://example.com/b", "title": "T", "content": "C", "usage": {"sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": 0.2, "currency": "usd"}}}, {"url": "https://example.com/c", "title": "T", "content": "C", "usage": {"sku": "fetch.prompt", "amount": 2, "credits": 2, "paid": true, "cost": {"amount": "0.000000001", "currency": "usd"}}}]}, "expect": {"usage": {"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.1", "currency": "usd"}}, {"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.2", "currency": "usd"}}, {"sku": "fetch.prompt", "quantity": 2, "price": {"amount": "0.000000001", "currency": "usd"}}], "total": {"amount": "0.300000001", "currency": "usd"}, "balance": null, "sku": "", "amount": 0, "credits": 0, "paid": false, "credits_remaining": null}, "pages": [{"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.1", "currency": "usd"}}], "total": {"amount": "0.1", "currency": "usd"}, "balance": null, "sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}, {"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.2", "currency": "usd"}}], "total": {"amount": "0.2", "currency": "usd"}, "balance": null, "sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}, {"items": [{"sku": "fetch.prompt", "quantity": 2, "price": {"amount": "0.000000001", "currency": "usd"}}], "total": {"amount": "0.000000001", "currency": "usd"}, "balance": null, "sku": "fetch.prompt", "amount": 2, "credits": 2, "paid": true, "credits_remaining": null}]}},
    {"name": "pages without money: items at price 0, total 0 in usd", "urls": ["https://example.com/a", "https://example.com/b"], "json": {"results": [{"url": "https://example.com/a", "title": "T", "content": "C", "usage": {"sku": "fetch", "amount": 1, "credits": 1, "paid": true}}, {"url": "https://example.com/b", "title": "T", "content": "C", "usage": {"sku": "fetch", "amount": 1, "credits": 1, "paid": true}}]}, "expect": {"usage": {"items": [{"sku": "fetch", "quantity": 2, "price": {"amount": "0", "currency": "usd"}}], "total": {"amount": "0", "currency": "usd"}, "balance": null, "sku": "", "amount": 0, "credits": 0, "paid": false, "credits_remaining": null}, "pages": [{"items": [{"sku": "fetch", "quantity": 1, "price": {"amount": "0", "currency": "usd"}}], "total": {"amount": "0", "currency": "usd"}, "balance": null, "sku": "fetch", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}, {"items": [{"sku": "fetch", "quantity": 1, "price": {"amount": "0", "currency": "usd"}}], "total": {"amount": "0", "currency": "usd"}, "balance": null, "sku": "fetch", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}]}},
    {"name": "no usage anywhere is null", "urls": ["https://example.com/a", "https://example.com/b"], "json": {"results": [{"url": "https://example.com/a", "title": "T", "content": "C"}, {"url": "https://example.com/b", "error": {"status": 404, "error": "Not found"}}]}, "expect": {"usage": null, "pages": [null, null]}},
    {"name": "a call usage that is not an object is built from the pages", "urls": ["https://example.com/a"], "json": {"results": [{"url": "https://example.com/a", "title": "T", "content": "C", "usage": {"sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": "0.002", "currency": "usd"}}}], "usage": "x"}, "expect": {"usage": {"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.002", "currency": "usd"}, "balance": null, "sku": "", "amount": 0, "credits": 0, "paid": false, "credits_remaining": null}, "pages": [{"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.002", "currency": "usd"}, "balance": null, "sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}]}},
    {"name": "the call's usage wins over the pages'", "urls": ["https://example.com/a"], "json": {"results": [{"url": "https://example.com/a", "title": "T", "content": "C", "usage": {"sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": "0.002", "currency": "usd"}}}], "usage": {"items": [], "total": {"amount": "0", "currency": "usd"}}}, "expect": {"usage": {"items": [], "total": {"amount": "0", "currency": "usd"}, "balance": null, "sku": "", "amount": 0, "credits": 0, "paid": false, "credits_remaining": null}, "pages": [{"items": [{"sku": "fetch.live", "quantity": 1, "price": {"amount": "0.002", "currency": "usd"}}], "total": {"amount": "0.002", "currency": "usd"}, "balance": null, "sku": "fetch.live", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}]}}
  ]
}
