{
  "_comment": "The session_id option, sent as the X-Keenable-Session-Id header. `client` is the client's session_id and `call` the call's; absent means not set. `client_headers` and `call_headers` are the client's default headers and the call's headers. Each case runs one search and one fetch against a server answering 200. `sent` is the header's value on the request, null for no header; `invalid` means the invalid-request error and nothing sent. The value is trimmed of surrounding spaces, and \"\" or blank is unset (a call's then keeps the client's). It must be printable ASCII (U+0020 to U+007E): HTTP stacks disagree on sending any other character. Its length is not checked: the API keeps the first 128 characters. Last wins, in this order: the client's default headers, the client's session_id, the call's headers, the call's session_id.",
  "cases": [
    {"name": "unset sends no header", "sent": null},
    {"name": "the client's is sent", "client": "run-1", "sent": "run-1"},
    {"name": "a call's alone is sent", "call": "run-2", "sent": "run-2"},
    {"name": "a call's replaces the client's", "client": "run-1", "call": "run-2", "sent": "run-2"},
    {"name": "an empty client value is unset", "client": "", "sent": null},
    {"name": "an empty call value keeps the client's", "client": "run-1", "call": "", "sent": "run-1"},
    {"name": "a blank value is unset", "client": "   ", "sent": null},
    {"name": "a blank call value keeps the client's", "client": "run-1", "call": "  ", "sent": "run-1"},
    {"name": "surrounding spaces are trimmed", "client": "  run-1  ", "sent": "run-1"},
    {"name": "inner spaces are kept", "client": "agent run 1", "sent": "agent run 1"},
    {"name": "punctuation is sent as given", "client": "agent:run/42#a=b;c,\"d\"", "sent": "agent:run/42#a=b;c,\"d\""},
    {"name": "a UUID", "client": "3f2b9c1e-8d4a-4c6b-9e2f-1a7d5b3c8e90", "sent": "3f2b9c1e-8d4a-4c6b-9e2f-1a7d5b3c8e90"},
    {"name": "a long value is sent whole (the API keeps the first 128 characters)", "client": "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss", "sent": "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss"},
    {"name": "the client option replaces a default header", "client": "run-1", "client_headers": {"X-Keenable-Session-Id": "h"}, "sent": "run-1"},
    {"name": "a default header alone is sent", "client_headers": {"x-keenable-session-id": "h"}, "sent": "h"},
    {"name": "a call header replaces the client option", "client": "run-1", "call_headers": {"X-Keenable-Session-Id": "h"}, "sent": "h"},
    {"name": "the call option replaces a call header", "call": "run-2", "call_headers": {"X-Keenable-Session-Id": "h"}, "sent": "run-2"},
    {"name": "client: CRLF", "client": "a\r\nX-Evil: 1", "invalid": true},
    {"name": "client: LF", "client": "a\nb", "invalid": true},
    {"name": "client: NUL", "client": "a\u0000b", "invalid": true},
    {"name": "client: a tab", "client": "a\tb", "invalid": true},
    {"name": "client: another control character", "client": "a\u0001b", "invalid": true},
    {"name": "client: DEL", "client": "a\u007fb", "invalid": true},
    {"name": "client: a non-ASCII letter", "client": "caf\u00e9", "invalid": true},
    {"name": "client: an emoji", "client": "run-\ud83d\ude80", "invalid": true},
    {"name": "client: a number", "client": 5, "invalid": true, "skip": {"go": "a string", "rust": "an Option<String>"}},
    {"name": "call: CRLF", "call": "a\r\nX-Evil: 1", "invalid": true},
    {"name": "call: a tab", "call": "a\tb", "invalid": true},
    {"name": "call: a non-ASCII letter", "client": "run-1", "call": "caf\u00e9", "invalid": true},
    {"name": "call: a number", "call": 5, "invalid": true, "skip": {"go": "a string", "rust": "an Option<String>"}}
  ]
}
