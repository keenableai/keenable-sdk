    {"name": "429 with Retry-After 0", "status": 429, "headers": {"Retry-After": "0"}, "json": {}, "retried": true, "wait": 0},
    {"name": "body retry_after_seconds over the header", "status": 429, "headers": {"Retry-After": "30"}, "json": {"retry_after_seconds": 2}, "retried": true, "wait": 2},
