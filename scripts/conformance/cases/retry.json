    {"name": "500", "status": 500, "json": {}, "retried": true, "wait": "backoff"},
    {"name": "502 with no body", "status": 502, "body": "", "retried": true, "wait": "backoff"},
    {"name": "503", "status": 503, "json": {"message": "busy"}, "retried": true, "wait": "backoff"},
    {"name": "504", "status": 504, "json": {}, "retried": true, "wait": "backoff"},
    {"name": "599", "status": 599, "json": {}, "retried": true, "wait": "backoff"},
