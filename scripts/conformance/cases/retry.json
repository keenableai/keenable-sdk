    {"name": "a zoneless date falls back to backoff", "status": 503, "headers": {"Retry-After": "Thu, 01 Jan 2026 00:00:30"}, "json": {}, "retried": true, "wait": "backoff"},
    {"name": "a past HTTP date is no wait", "status": 503, "headers": {"Retry-After": "Wed, 21 Oct 2015 07:28:00 GMT"}, "json": {}, "retried": true, "wait": 0},
