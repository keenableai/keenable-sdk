{
  "_comment": "The anonymous client ID a keyless client keeps. `tokens` are X-Keenable-Client header values (and client-id file contents after trimming), each [value, accepted, why]: an accepted value is stored and sent back as it is; any other is ignored as if the header were absent. A token is 1 to 128 characters of A-Z a-z 0-9 . _ - and is never parsed. `paths` give the client-id file for a platform (windows, linux or darwin), the environment variables that are set, and the home directory (\"\" when it is unknown); path null means there is no file and the ID stays in memory. Paths are joined with \\ on windows and / elsewhere.",
  "tokens": [
    ["kc1.AbC-dEf_123.s1x2y3.q9", true, "a normal token"],
    ["a", true, "one character"],
    ["A-Za-z0-9._-", true, "every kind of allowed character"],
    ["...", true, "dots only: the token is not parsed"],
    ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", true, "128 characters"],
    ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", false, "129 characters"],
    ["", false, "empty"],
    [" ", false, "a space only"],
    ["kc1 abc", false, "a space inside"],
    [" kc1.abc", false, "a leading space"],
    ["kc1.abc ", false, "a trailing space"],
    ["kc1/abc", false, "a slash"],
    ["kc1\\abc", false, "a backslash"],
    ["kc1.abc\n", false, "a trailing newline"],
    ["kc1.abc\nkc1.def", false, "two lines"],
    ["kc1\tabc", false, "a tab"],
    ["kc1.abc, kc1.def", false, "two header values joined"],
    ["kc1+abc", false, "a plus"],
    ["kc1=abc", false, "an equals sign"],
    ["kc1:abc", false, "a colon"],
    ["kc1~abc", false, "a tilde"],
    ["kc1.é", false, "a non-ASCII letter"],
    ["kc1.١", false, "a non-ASCII digit"],
    ["kc1.abc\u0000", false, "a NUL"]
  ],
  "paths": [
    {"name": "linux: XDG_CONFIG_HOME", "platform": "linux", "env": {"XDG_CONFIG_HOME": "/xdg"}, "home": "/home/u", "path": "/xdg/keenable/client-id"},
    {"name": "linux: XDG_CONFIG_HOME with a trailing slash", "platform": "linux", "env": {"XDG_CONFIG_HOME": "/xdg/"}, "home": "/home/u", "path": "/xdg/keenable/client-id"},
    {"name": "linux: XDG_CONFIG_HOME is the root", "platform": "linux", "env": {"XDG_CONFIG_HOME": "/"}, "home": "/home/u", "path": "/keenable/client-id"},
    {"name": "linux: no XDG_CONFIG_HOME", "platform": "linux", "env": {}, "home": "/home/u", "path": "/home/u/.config/keenable/client-id"},
    {"name": "linux: an empty XDG_CONFIG_HOME is unset", "platform": "linux", "env": {"XDG_CONFIG_HOME": ""}, "home": "/home/u", "path": "/home/u/.config/keenable/client-id"},
    {"name": "linux: a relative XDG_CONFIG_HOME is ignored", "platform": "linux", "env": {"XDG_CONFIG_HOME": "xdg/config"}, "home": "/home/u", "path": "/home/u/.config/keenable/client-id"},
    {"name": "linux: a dot-relative XDG_CONFIG_HOME is ignored", "platform": "linux", "env": {"XDG_CONFIG_HOME": "./xdg"}, "home": "/home/u", "path": "/home/u/.config/keenable/client-id"},
    {"name": "linux: a Windows path in XDG_CONFIG_HOME is not absolute", "platform": "linux", "env": {"XDG_CONFIG_HOME": "C:\\xdg"}, "home": "/home/u", "path": "/home/u/.config/keenable/client-id"},
    {"name": "linux: APPDATA is not read", "platform": "linux", "env": {"APPDATA": "/appdata"}, "home": "/home/u", "path": "/home/u/.config/keenable/client-id"},
    {"name": "linux: the home directory is the root", "platform": "linux", "env": {}, "home": "/", "path": "/.config/keenable/client-id"},
    {"name": "linux: no home directory and no XDG_CONFIG_HOME", "platform": "linux", "env": {}, "home": "", "path": null},
    {"name": "linux: no home directory but XDG_CONFIG_HOME", "platform": "linux", "env": {"XDG_CONFIG_HOME": "/xdg"}, "home": "", "path": "/xdg/keenable/client-id"},
    {"name": "darwin: ~/.config, not ~/Library", "platform": "darwin", "env": {}, "home": "/Users/u", "path": "/Users/u/.config/keenable/client-id"},
