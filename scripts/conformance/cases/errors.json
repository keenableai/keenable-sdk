    {"name": "an invalid_filter 400 names the rejected value and reason", "status": 400, "json": {"error": "invalid_filter", "message": "Invalid exclude_domains value \"spam.com/blog\": paths are not supported; give only the host, such as example.com", "field": "exclude_domains", "value": "spam.com/blog", "reason": "paths are not supported; give only the host, such as example.com", "type": "invalid_request_error", "code": "invalid_parameter", "fix": "Correct the \"exclude_domains\" entry \"spam.com/blog\" (paths are not supported; give only the host, such as example.com) and retry.", "docs_url": "https://docs.keenable.ai/errors#invalid-parameter", "retryable": false, "param": "exclude_domains"}, "expect": {"kind": "api", "type": "invalid_request_error", "code": "invalid_parameter", "detail": "Invalid exclude_domains value \"spam.com/blog\": paths are not supported; give only the host, such as example.com", "error": "invalid_filter", "fix": "Correct the \"exclude_domains\" entry \"spam.com/blog\" (paths are not supported; give only the host, such as example.com) and retry.", "retryable": false, "param": "exclude_domains", "value": "spam.com/blog", "reason": "paths are not supported; give only the host, such as example.com", "message_contains": ["Correct the \"exclude_domains\" entry \"spam.com/blog\" (paths are not supported; give only the host, such as example.com) and retry."], "absent": ["https://docs.keenable.ai/errors#invalid-parameter"]}},
