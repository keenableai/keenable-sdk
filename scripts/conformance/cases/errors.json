{
  "_comment": "Error responses to a search with retries off, and the error each SDK raises. `json` is sent as its JSON text; `body` as is. expect.detail is the error's `body`: the first of the body's message, error and detail that is a string with more than whitespace, or for a body that is not JSON its trimmed text. A body that is JSON but not an object gives no detail and no fields, and maps by status. Fields left out of expect are null; value and reason (and param from field, when param is absent) are read only from a 400 whose error is invalid_filter (sync.ts fills them in). message_contains and message_excludes are checked against the error's message; each string in `absent` must appear in neither the message nor any field except `body` and `fix`.",
  "cases": [
    {"name": "a numeric message is skipped", "status": 400, "json": {"message": 42, "error": "Bad thing"}, "expect": {"kind": "api", "type": "invalid_request_error", "detail": "Bad thing", "error": "Bad thing", "message_contains": ["Bad thing"], "message_excludes": ["42"]}},
    {"name": "an object message is skipped, not stringified", "status": 500, "json": {"message": {"text": "inner"}}, "expect": {"kind": "api", "type": "api_error", "message_excludes": ["inner", "[object Object]", "map[", "{'text'"]}},
    {"name": "an array message is skipped", "status": 400, "json": {"message": ["a", "b"], "detail": "the detail"}, "expect": {"kind": "api", "type": "invalid_request_error", "detail": "the detail", "message_contains": ["the detail"]}},
    {"name": "a boolean message is skipped", "status": 400, "json": {"message": true}, "expect": {"kind": "api", "type": "invalid_request_error", "message_excludes": ["true", "True"]}},
    {"name": "a null message is skipped", "status": 400, "json": {"message": null, "detail": "D"}, "expect": {"kind": "api", "type": "invalid_request_error", "detail": "D"}},
    {"name": "a blank message is skipped", "status": 400, "json": {"message": "   ", "error": "E"}, "expect": {"kind": "api", "type": "invalid_request_error", "detail": "E", "error": "E"}},
    {"name": "a numeric error title is skipped", "status": 400, "json": {"error": 7, "detail": "D"}, "expect": {"kind": "api", "type": "invalid_request_error", "detail": "D"}},
    {"name": "the message keeps its own whitespace", "status": 400, "json": {"message": " spaced "}, "expect": {"kind": "api", "type": "invalid_request_error", "detail": " spaced "}},
    {"name": "a JSON string body gives no detail", "status": 500, "body": "\"oops\"", "expect": {"kind": "api", "type": "api_error", "message_excludes": ["oops"]}},
    {"name": "a JSON null body gives no detail", "status": 400, "body": "null", "expect": {"kind": "api", "type": "invalid_request_error", "message_excludes": ["null"]}},
    {"name": "a JSON number body on a 429", "status": 429, "body": "4242", "expect": {"kind": "rate_limit", "type": "rate_limit_error", "message_excludes": ["4242"]}},
    {"name": "a JSON array body on a 401", "status": 401, "body": "[\"x\"]", "expect": {"kind": "auth", "type": "authentication_error", "message_excludes": ["[\"x\"]"]}},
    {"name": "a JSON boolean body on a 403", "status": 403, "body": "true", "expect": {"kind": "auth", "type": "permission_error"}},
    {"name": "a JSON number too large for a double", "status": 500, "body": "1e400", "expect": {"kind": "api", "type": "api_error", "message_excludes": ["1e400"]}},
    {"name": "an HTML body is the detail", "status": 502, "body": "<html>Bad Gateway</html>", "expect": {"kind": "api", "type": "api_error", "detail": "<html>Bad Gateway</html>", "message_contains": ["<html>Bad Gateway</html>"]}},
    {"name": "a plain-text body is trimmed", "status": 400, "body": "  plain text \n", "expect": {"kind": "api", "type": "invalid_request_error", "detail": "plain text"}},
    {"name": "an empty body", "status": 500, "body": "", "expect": {"kind": "api", "type": "api_error"}},
    {"name": "a NaN literal is not JSON", "status": 503, "body": "{\"message\":\"m\",\"retry_after_seconds\":NaN}", "expect": {"kind": "api", "type": "api_error", "detail": "{\"message\":\"m\",\"retry_after_seconds\":NaN}"}},
    {"name": "an Infinity literal is not JSON", "status": 400, "body": "{\"message\":\"m\",\"x\":Infinity}", "expect": {"kind": "api", "type": "invalid_request_error", "detail": "{\"message\":\"m\",\"x\":Infinity}"}},
    {"name": "trailing data is not JSON", "status": 400, "body": "{\"message\":\"m\"} extra", "expect": {"kind": "api", "type": "invalid_request_error", "detail": "{\"message\":\"m\"} extra"}},
    {"name": "a leading byte order mark is ignored", "status": 400, "body": "﻿{\"message\":\"bom\",\"code\":\"c\"}", "expect": {"kind": "api", "type": "invalid_request_error", "detail": "bom", "code": "c", "message_contains": ["bom"]}},
    {"name": "an overflowing number drops only that field", "status": 400, "body": "{\"message\":\"m\",\"code\":\"c\",\"retry_after_seconds\":1e400}", "expect": {"kind": "api", "type": "invalid_request_error", "detail": "m", "code": "c"}},
    {"name": "a numeric type is derived instead", "status": 403, "json": {"type": 5, "code": "target_blocked"}, "expect": {"kind": "api", "type": "target_error", "code": "target_blocked"}},
    {"name": "a numeric code is ignored", "status": 400, "json": {"code": 7}, "expect": {"kind": "api", "type": "invalid_request_error", "message_excludes": ["(code:"]}},
    {"name": "an unknown type passes through", "status": 400, "json": {"type": "brand_new_error"}, "expect": {"kind": "api", "type": "brand_new_error"}},
    {"name": "retryable as a string is ignored", "status": 400, "json": {"retryable": "yes"}, "expect": {"kind": "api", "type": "invalid_request_error"}},
    {"name": "the body's request id over the header's", "status": 400, "headers": {"X-Request-Id": "from-header"}, "json": {"request_id": "from-body"}, "expect": {"kind": "api", "type": "invalid_request_error", "request_id": "from-body", "message_contains": ["(request_id: from-body)"]}},
    {"name": "a blank body request id falls back to the header", "status": 400, "headers": {"X-Request-Id": "  from-header  "}, "json": {"request_id": " "}, "expect": {"kind": "api", "type": "invalid_request_error", "request_id": "from-header"}},
    {"name": "a numeric body request id falls back to the header", "status": 400, "headers": {"X-Request-Id": "from-header"}, "json": {"request_id": 5}, "expect": {"kind": "api", "type": "invalid_request_error", "request_id": "from-header"}},
    {"name": "a blank header request id is none", "status": 400, "headers": {"X-Request-Id": "   "}, "json": {}, "expect": {"kind": "api", "type": "invalid_request_error"}},
    {"name": "a request id on a non-JSON body", "status": 502, "headers": {"X-Request-Id": "rid"}, "body": "bad gateway", "expect": {"kind": "api", "type": "api_error", "detail": "bad gateway", "request_id": "rid"}},
    {"name": "a negative body delay falls through to the header", "status": 429, "headers": {"Retry-After": "3"}, "json": {"retry_after_seconds": -1}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "retry_after_seconds": 3}},
    {"name": "a fractional body delay", "status": 429, "json": {"retry_after_seconds": 0.25}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "retry_after_seconds": 0.25}},
    {"name": "a huge body delay is capped at a year", "status": 429, "json": {"retry_after_seconds": 1e12}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "retry_after_seconds": 31536000}},
    {"name": "a string body delay is ignored", "status": 429, "json": {"retry_after_seconds": "5"}, "expect": {"kind": "rate_limit", "type": "rate_limit_error"}},
    {"name": "a numeric-zone Retry-After date is ignored", "status": 429, "headers": {"Retry-After": "Thu, 01 Jan 2099 00:00:00 +0000"}, "json": {}, "expect": {"kind": "rate_limit", "type": "rate_limit_error"}},
    {"name": "a zoneless Retry-After date is ignored", "status": 429, "headers": {"Retry-After": "Thu, 01 Jan 2099 00:00:00"}, "json": {}, "expect": {"kind": "rate_limit", "type": "rate_limit_error"}},
    {"name": "a far-future Retry-After date is capped at a year", "status": 429, "headers": {"Retry-After": "Thu, 01 Jan 2099 00:00:00 GMT"}, "json": {}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "retry_after_seconds": 31536000}},
    {"name": "a full limit", "status": 429, "json": {"limit": {"scope": "ip", "window": "hour", "max": 1000, "resets_at": "2026-11-06T12:30:00.000Z"}}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "limit": {"scope": "ip", "window": "hour", "max": 1000, "resets_at": "2026-11-06T12:30:00.000Z"}}},
    {"name": "an empty limit", "status": 429, "json": {"limit": {}}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "limit": {"scope": null, "window": null, "max": null, "resets_at": null}}},
    {"name": "limit max as a fraction", "status": 429, "json": {"limit": {"max": 1.5}}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "limit": {"scope": null, "window": null, "max": null, "resets_at": null}}},
    {"name": "limit max negative", "status": 429, "json": {"limit": {"max": -1}}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "limit": {"scope": null, "window": null, "max": null, "resets_at": null}}},
    {"name": "limit max past 2^53", "status": 429, "json": {"limit": {"max": 1e300}}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "limit": {"scope": null, "window": null, "max": null, "resets_at": null}}},
    {"name": "limit max as a string", "status": 429, "json": {"limit": {"max": "10", "scope": 5}}, "expect": {"kind": "rate_limit", "type": "rate_limit_error", "limit": {"scope": null, "window": null, "max": null, "resets_at": null}}},
    {"name": "limit as an array", "status": 429, "json": {"limit": [1]}, "expect": {"kind": "rate_limit", "type": "rate_limit_error"}},
    {"name": "limit as a string", "status": 429, "json": {"limit": "10/s"}, "expect": {"kind": "rate_limit", "type": "rate_limit_error"}},
    {"name": "a 401 about the fetched page is not an auth error", "status": 401, "json": {"type": "target_error", "message": "the site wants a login"}, "expect": {"kind": "api", "type": "target_error", "detail": "the site wants a login", "message_contains": ["Keenable API error (401)"], "message_excludes": ["authentication failed"]}},
    {"name": "a 403 with a target code is not an auth error", "status": 403, "json": {"code": "target_blocked"}, "expect": {"kind": "api", "type": "target_error", "code": "target_blocked"}},
    {"name": "page_not_found is a target error", "status": 404, "json": {"code": "page_not_found"}, "expect": {"kind": "api", "type": "target_error", "code": "page_not_found"}},
    {"name": "418", "status": 418, "json": {}, "expect": {"kind": "api", "type": "invalid_request_error"}},
    {"name": "451", "status": 451, "json": {}, "expect": {"kind": "api", "type": "billing_error"}},
    {"name": "599", "status": 599, "json": {}, "expect": {"kind": "api", "type": "api_error"}},
    {"name": "docs_url is not exposed", "status": 400, "json": {"code": "invalid_parameter", "message": "bad max_results", "fix": "Correct max_results.", "param": "max_results", "docs_url": "https://docs.keenable.ai/errors#400-invalid-request"}, "expect": {"kind": "api", "type": "invalid_request_error", "code": "invalid_parameter", "detail": "bad max_results", "fix": "Correct max_results.", "param": "max_results", "message_contains": ["bad max_results", "Correct max_results."], "message_excludes": ["Docs:"], "absent": ["https://docs.keenable.ai/errors#400-invalid-request"]}},
    {"name": "insufficient credits: no billing or checkout URLs", "status": 402, "headers": {"X-Request-Id": "req-402"}, "json": {"error": "Insufficient credits", "type": "billing_error", "code": "insufficient_credits", "message": "No credits left.", "fix": "Ask a human with console access to buy credits.", "docs_url": "https://docs.keenable.ai/errors#402", "retryable": false, "billing_url": "https://app.keenable.ai/console/billing", "auto_top_up_url": "https://docs.keenable.ai/auto-top-up.md", "pay_per_request": "Pay per request over x402 at https://docs.keenable.ai/pay-per-request.md", "details": {"checkoutUrl": "https://checkout.example.com/session/abc"}, "request_id": "req-402"}, "expect": {"kind": "insufficient_credits", "type": "billing_error", "code": "insufficient_credits", "error": "Insufficient credits", "detail": "No credits left.", "fix": "Ask a human with console access to buy credits.", "retryable": false, "request_id": "req-402", "message_contains": ["Keenable: insufficient credits (402)", "(code: insufficient_credits)", "(request_id: req-402)"], "message_excludes": ["Docs:", "http"], "absent": ["https://docs.keenable.ai/errors#402", "https://app.keenable.ai/console/billing", "https://docs.keenable.ai/auto-top-up.md", "pay-per-request", "x402", "https://checkout.example.com/session/abc"]}},
    {"name": "a bare x402 payment offer: no offer data", "status": 402, "json": {"x402Version": 1, "error": "X-PAYMENT header is required", "accepts": [{"scheme": "exact", "network": "base-sepolia", "maxAmountRequired": "1000", "resource": "https://api.keenable.ai/v1/x402/search", "description": "Keenable search", "mimeType": "application/json", "payTo": "0x1111111111111111111111111111111111111111", "maxTimeoutSeconds": 60, "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e", "extra": {"name": "USDC", "version": "2"}}]}, "expect": {"kind": "insufficient_credits", "type": "billing_error", "error": "X-PAYMENT header is required", "detail": "X-PAYMENT header is required", "message_contains": ["Keenable: payment required (402)", "does not pay"], "message_excludes": ["http"], "absent": ["0x1111111111111111111111111111111111111111", "base-sepolia", "0x036CbD53842c5426634e7929541eC2318f3dCF7e", "https://api.keenable.ai/v1/x402/search", "maxAmountRequired", "USDC"]}},
    {"name": "payment_required: no offer data", "status": 402, "headers": {"X-Request-Id": "req-x402"}, "json": {"error": "Payment required", "type": "billing_error", "code": "payment_required", "message": "This endpoint is paid per request.", "fix": "Pay and send the same request again: with x402, sign one of the \"accepts\" offers and retry with the PAYMENT-SIGNATURE header.", "docs_url": "https://docs.keenable.ai/pay-per-request.md", "retryable": false, "request_id": "req-x402", "x402Version": 2, "accepts": [{"scheme": "exact", "network": "eip155:8453", "amount": "1000", "payTo": "0x2222222222222222222222222222222222222222", "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"}]}, "expect": {"kind": "insufficient_credits", "type": "billing_error", "code": "payment_required", "error": "Payment required", "detail": "This endpoint is paid per request.", "fix": "Pay and send the same request again: with x402, sign one of the \"accepts\" offers and retry with the PAYMENT-SIGNATURE header.", "retryable": false, "request_id": "req-x402", "message_contains": ["Keenable: payment required (402)", "(code: payment_required)", "(request_id: req-x402)"], "message_excludes": ["http", "PAYMENT-SIGNATURE"], "absent": ["0x2222222222222222222222222222222222222222", "eip155:8453", "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", "https://docs.keenable.ai/pay-per-request.md"]}},
