{
  "_comment": "GET /v1/billing (retries off) and what billing() returns. keyed says whether the client has an API key. The path is /v1/billing either way: billing has no /public variant, and the key is sent only when keyed. `json` is sent as its JSON text; `body` as is. A body that is not a JSON object is an API error (expect.error is its kind). Required text (sku, unit, billing_url, as_of, and a Money's currency) is the string sent or \"\". A Money's amount is the finite JSON number sent (US dollars, fraction and sign kept), else 0, like any other wrong-typed number: a string such as an older server's \"0.004\" is 0, never parsed. A Money's amount_decimal is the string sent when it matches ^-?[0-9]+(\\.[0-9]{1,9})?$ (ASCII digits, nothing around them), else the amount above written with at most nine decimal places (correctly rounded, no exponent), trailing zeros and a bare point trimmed, and \"-0\" as \"0\": an older server sends none.A required Money (unit_price, available) that is not an object reads as {}, so its amount is 0 and its currency is \"\"; list_unit_price is a Money when an object, else null; source is a string with more than whitespace, else null. account is null unless an object; a balance that is not an object reads as {}. prices keeps its object entries and is [] when not a list. Fields an older server sent (balance.purchased, usage) are ignored. request_id is the body's when such a string, else the trimmed X-Request-Id header, else null.",
  "cases": [
    {"name": "keyless: GET /v1/billing, not /public, list prices and no account", "keyed": false,
     "json": {"object": "billing", "prices": [{"sku": "search.pro", "unit": "search", "unit_price": {"amount": 0.004, "amount_decimal": "0.004", "currency": "usd"}}, {"sku": "fetch.live", "unit": "page", "unit_price": {"amount": 0.002, "amount_decimal": "0.002", "currency": "usd"}}], "account": null},
     "expect": {"path": "/v1/billing", "billing": {"prices": [{"sku": "search.pro", "unit": "search", "unit_price": {"amount": 0.004, "amount_decimal": "0.004", "currency": "usd"}, "list_unit_price": null, "source": null}, {"sku": "fetch.live", "unit": "page", "unit_price": {"amount": 0.002, "amount_decimal": "0.002", "currency": "usd"}, "list_unit_price": null, "source": null}], "account": null}}},
    {"name": "keyed: the key is sent, a contract price and a negative balance", "keyed": true, "headers": {"X-Request-Id": " req-1 "},
     "json": {"object": "billing", "prices": [{"sku": "search.pro", "unit": "search", "unit_price": {"amount": 0.003, "amount_decimal": "0.003", "currency": "usd"}, "list_unit_price": {"amount": 0.004, "amount_decimal": "0.004", "currency": "usd"}, "source": "contract"}, {"sku": "fetch", "unit": "page", "unit_price": {"amount": 0.001, "amount_decimal": "0.001", "currency": "usd"}, "list_unit_price": {"amount": 0.001, "amount_decimal": "0.001", "currency": "usd"}, "source": "list"}], "account": {"balance": {"available": {"amount": -12.345678901, "amount_decimal": "-12.345678901", "currency": "usd"}}, "billing_url": "https://keenable.ai/console?tab=billing", "as_of": "2026-11-22T10:00:00.000Z"}},
     "expect": {"path": "/v1/billing", "request_id": "req-1", "billing": {"prices": [{"sku": "search.pro", "unit": "search", "unit_price": {"amount": 0.003, "amount_decimal": "0.003", "currency": "usd"}, "list_unit_price": {"amount": 0.004, "amount_decimal": "0.004", "currency": "usd"}, "source": "contract"}, {"sku": "fetch", "unit": "page", "unit_price": {"amount": 0.001, "amount_decimal": "0.001", "currency": "usd"}, "list_unit_price": {"amount": 0.001, "amount_decimal": "0.001", "currency": "usd"}, "source": "list"}], "account": {"balance": {"available": {"amount": -12.345678901, "amount_decimal": "-12.345678901", "currency": "usd"}}, "billing_url": "https://keenable.ai/console?tab=billing", "as_of": "2026-11-22T10:00:00.000Z"}}}},
    {"name": "an empty object", "keyed": false, "json": {},
     "expect": {"path": "/v1/billing", "billing": {"prices": [], "account": null}}},
    {"name": "the body's request id over the header's", "keyed": false, "headers": {"X-Request-Id": "hdr"}, "json": {"request_id": "body", "prices": []},
     "expect": {"path": "/v1/billing", "request_id": "body", "billing": {"prices": [], "account": null}}},
    {"name": "mistyped prices fall back", "keyed": false,
     "json": {"prices": [1, "x", null, [], {"sku": 5, "unit": null, "unit_price": "0.004", "list_unit_price": 7, "source": " "}, {"sku": "fetch", "unit": "page", "unit_price": {"amount": "0.001", "currency": 5}, "list_unit_price": {"amount": true, "currency": "usd"}, "source": 1}, {"sku": "search", "unit": "search", "unit_price": {"amount": 0.000000001, "currency": "usd"}, "list_unit_price": {"amount": null}}]},
     "expect": {"path": "/v1/billing", "billing": {"prices": [{"sku": "", "unit": "", "unit_price": {"amount": 0, "amount_decimal": "0", "currency": ""}, "list_unit_price": null, "source": null}, {"sku": "fetch", "unit": "page", "unit_price": {"amount": 0, "amount_decimal": "0", "currency": ""}, "list_unit_price": {"amount": 0, "amount_decimal": "0", "currency": "usd"}, "source": null}, {"sku": "search", "unit": "search", "unit_price": {"amount": 0.000000001, "amount_decimal": "0.000000001", "currency": "usd"}, "list_unit_price": {"amount": 0, "amount_decimal": "0", "currency": ""}, "source": null}], "account": null}}},
    {"name": "prices as an object and account as a string", "keyed": true, "json": {"prices": {"sku": "search.pro"}, "account": "none"},
     "expect": {"path": "/v1/billing", "billing": {"prices": [], "account": null}}},
    {"name": "mistyped account fields fall back", "keyed": true,
     "json": {"prices": [], "account": {"balance": {"available": {"amount": "0.004", "currency": 5}}, "billing_url": 5, "as_of": null}},
     "expect": {"path": "/v1/billing", "billing": {"prices": [], "account": {"balance": {"available": {"amount": 0, "amount_decimal": "0", "currency": ""}}, "billing_url": "", "as_of": ""}}}},
    {"name": "an account with no balance", "keyed": true,
     "json": {"account": {"balance": null, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}},
     "expect": {"path": "/v1/billing", "billing": {"prices": [], "account": {"balance": {"available": {"amount": 0, "amount_decimal": "0", "currency": ""}}, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}}}},
    {"name": "a balance that is a list and the fields an older server sent", "keyed": true,
     "json": {"account": {"balance": [], "usage": {"since": "2026-11-01T00:00:00.000Z", "cost": {"amount": 1.25, "currency": "usd"}, "line_items": [{"sku": "search", "quantity": 250, "cost": {"amount": 1, "currency": "usd"}}]}, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}},
     "expect": {"path": "/v1/billing", "billing": {"prices": [], "account": {"balance": {"available": {"amount": 0, "amount_decimal": "0", "currency": ""}}, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}}}},
    {"name": "an older server's purchased balance is ignored", "keyed": true,
     "json": {"account": {"balance": {"available": {"amount": 5.5, "amount_decimal": "5.5", "currency": "usd"}, "purchased": {"amount": 3, "amount_decimal": "3", "currency": "usd"}}, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}},
     "expect": {"path": "/v1/billing", "billing": {"prices": [], "account": {"balance": {"available": {"amount": 5.5, "amount_decimal": "5.5", "currency": "usd"}}, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}}}},
    {"name": "an amount too large for a double is 0, the rest is kept", "keyed": false,
     "body": "{\"prices\": [{\"sku\": \"huge\", \"unit\": \"page\", \"unit_price\": {\"amount\": 1e999, \"currency\": \"usd\"}, \"list_unit_price\": {\"amount\": [1], \"currency\": \"usd\"}}]}",
     "expect": {"path": "/v1/billing", "billing": {"prices": [{"sku": "huge", "unit": "page", "unit_price": {"amount": 0, "amount_decimal": "0", "currency": "usd"}, "list_unit_price": {"amount": 0, "amount_decimal": "0", "currency": "usd"}, "source": null}], "account": null}}},
    {"name": "amount_decimal is kept as sent, exact where amount is not", "keyed": true,
     "json": {"prices": [{"sku": "a", "unit": "search", "unit_price": {"amount": 12345678.123456789, "amount_decimal": "12345678.123456789", "currency": "usd"}, "list_unit_price": {"amount": 0, "amount_decimal": "0", "currency": "usd"}}], "account": {"balance": {"available": {"amount": -0.5, "amount_decimal": "-0.5", "currency": "usd"}}, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}},
     "expect": {"path": "/v1/billing", "billing": {"prices": [{"sku": "a", "unit": "search", "unit_price": {"amount": 12345678.123456789, "amount_decimal": "12345678.123456789", "currency": "usd"}, "list_unit_price": {"amount": 0, "amount_decimal": "0", "currency": "usd"}, "source": null}], "account": {"balance": {"available": {"amount": -0.5, "amount_decimal": "-0.5", "currency": "usd"}}, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}}}},
    {"name": "an older server without amount_decimal: amount with at most nine decimals, trailing zeros trimmed", "keyed": true,
     "json": {"prices": [{"sku": "a", "unit": "search", "unit_price": {"amount": 0.004, "currency": "usd"}, "list_unit_price": {"amount": 100, "currency": "usd"}}, {"sku": "b", "unit": "page", "unit_price": {"amount": 0.000000001, "currency": "usd"}, "list_unit_price": {"amount": 0.0000000004, "currency": "usd"}}, {"sku": "c", "unit": "page", "unit_price": {"amount": -0.0000000004, "currency": "usd"}, "list_unit_price": {"amount": 1e21, "currency": "usd"}}, {"sku": "d", "unit": "page", "unit_price": {"amount": 0.30000000000000004, "currency": "usd"}, "list_unit_price": {"amount": 25000000.5, "currency": "usd"}}], "account": {"balance": {"available": {"amount": -12.345678901, "currency": "usd"}}, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}},
     "expect": {"path": "/v1/billing", "billing": {"prices": [{"sku": "a", "unit": "search", "unit_price": {"amount": 0.004, "amount_decimal": "0.004", "currency": "usd"}, "list_unit_price": {"amount": 100, "amount_decimal": "100", "currency": "usd"}, "source": null}, {"sku": "b", "unit": "page", "unit_price": {"amount": 0.000000001, "amount_decimal": "0.000000001", "currency": "usd"}, "list_unit_price": {"amount": 0.0000000004, "amount_decimal": "0", "currency": "usd"}, "source": null}, {"sku": "c", "unit": "page", "unit_price": {"amount": -0.0000000004, "amount_decimal": "0", "currency": "usd"}, "list_unit_price": {"amount": 1e21, "amount_decimal": "1000000000000000000000", "currency": "usd"}, "source": null}, {"sku": "d", "unit": "page", "unit_price": {"amount": 0.30000000000000004, "amount_decimal": "0.3", "currency": "usd"}, "list_unit_price": {"amount": 25000000.5, "amount_decimal": "25000000.5", "currency": "usd"}, "source": null}], "account": {"balance": {"available": {"amount": -12.345678901, "amount_decimal": "-12.345678901", "currency": "usd"}}, "billing_url": "https://keenable.ai/console", "as_of": "2026-11-22T10:00:00Z"}}}},
    {"name": "an amount_decimal that is not a plain decimal string falls back to amount", "keyed": false,
     "json": {"prices": [{"sku": "number", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": 0.25, "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": null, "currency": "usd"}}, {"sku": "exponent", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "2.5e-1", "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": "", "currency": "usd"}}, {"sku": "ten decimals", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "0.2500000000", "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": " 0.25", "currency": "usd"}}, {"sku": "signs and dots", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "+0.25", "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": ".25", "currency": "usd"}}, {"sku": "trailing dot and newline", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "0.", "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": "0.25\n", "currency": "usd"}}, {"sku": "not ASCII digits", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "٠.٢٥", "currency": "usd"}, "list_unit_price": {"amount": "0.25", "amount_decimal": ["0.25"], "currency": "usd"}}]},
     "expect": {"path": "/v1/billing", "billing": {"prices": [{"sku": "number", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "source": null}, {"sku": "exponent", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "source": null}, {"sku": "ten decimals", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "source": null}, {"sku": "signs and dots", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "source": null}, {"sku": "trailing dot and newline", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "list_unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "source": null}, {"sku": "not ASCII digits", "unit": "page", "unit_price": {"amount": 0.25, "amount_decimal": "0.25", "currency": "usd"}, "list_unit_price": {"amount": 0, "amount_decimal": "0", "currency": "usd"}, "source": null}], "account": null}}},
    {"name": "a JSON array body", "keyed": true, "body": "[]", "expect": {"path": "/v1/billing", "error": "api"}},
    {"name": "a keyless JSON null body", "keyed": false, "body": "null", "expect": {"path": "/v1/billing", "error": "api"}}
  ]
}
