    {"name": "usage today (old shape): one item from sku, amount and cost, total from cost", "endpoint": "search", "arg": "q", "json": {"query": "q", "results": [], "usage": {"sku": "search.pro", "amount": 1, "credits": 1, "paid": true, "credits_remaining": 11998, "cost": {"amount": 0.004, "amount_decimal": "0.004", "currency": "usd"}, "balance": {"amount": 47.992, "amount_decimal": "47.992", "currency": "usd"}}}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [], "usage": {"items": [{"sku": "search.pro", "quantity": 1, "price": {"amount": "0.004", "currency": "usd"}}], "total": {"amount": "0.004", "currency": "usd"}, "balance": {"amount": "47.992", "currency": "usd"}, "sku": "search.pro", "amount": 1, "credits": 1, "paid": true, "credits_remaining": 11998}}},
    {"name": "usage money from an older server without amount_decimal", "endpoint": "search", "arg": "q", "json": {"query": "q", "results": [], "usage": {"sku": "search.pro", "amount": 1, "credits": 1, "paid": true, "cost": {"amount": 0.004, "currency": "usd"}, "balance": {"amount": -4e-10, "currency": "usd"}}}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [], "usage": {"items": [{"sku": "search.pro", "quantity": 1, "price": {"amount": "0.004", "currency": "usd"}}], "total": {"amount": "0.004", "currency": "usd"}, "balance": {"amount": "0", "currency": "usd"}, "sku": "search.pro", "amount": 1, "credits": 1, "paid": true, "credits_remaining": null}}},
