{
  "_comment": "Success responses (retries off) and what search(arg) or fetch(arg) returns. `json` is sent as its JSON text; `body` as is. A body that is not a JSON object is an API error (expect.error is its kind) and is not retried. title, url, snippet and content are the string sent, or \"\" for anything else; description, author and mode are a string with more than whitespace, or null. published_at and acquired_at are such a string as sent, or a number of Unix seconds (what fetch sends) given as ISO 8601 UTC to the second (\"2024-05-01T12:00:00Z\", a fraction dropped) when from 1 to 253402300799 (the end of 9999), else null. A page's truncated is a boolean and its total_chars an integer from 0 to 2^53 - 1, else null (unset when the case leaves them out). query is the echo when it is such a string, else the query sent; a page's url likewise falls back to the URL asked for. request_id is the body's when it is such a string, else the trimmed X-Request-Id header, else null.",
  "cases": [
    {"name": "a full search", "endpoint": "search", "arg": "q", "json": {"query": "q", "mode": "pro", "results": [{"title": "T", "url": "https://e.com/", "snippet": "S", "description": "D", "published_at": "2024-01-01", "acquired_at": "2024-02-02"}]}, "expect": {"query": "q", "mode": "pro", "request_id": null, "results": [{"title": "T", "url": "https://e.com/", "snippet": "S", "description": "D", "published_at": "2024-01-01", "acquired_at": "2024-02-02"}]}},
    {"name": "an empty object", "endpoint": "search", "arg": "q", "json": {}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "extra fields are ignored", "endpoint": "search", "arg": "q", "json": {"results": [{"title": "T", "url": "u", "snippet": "s", "score": 0.9}], "took_ms": 12, "debug": {"x": 1}}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "T", "url": "u", "snippet": "s", "description": null, "published_at": null, "acquired_at": null}]}},
    {"name": "results null", "endpoint": "search", "arg": "q", "json": {"results": null}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "results as an object", "endpoint": "search", "arg": "q", "json": {"results": {"title": "T"}}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "results as a string", "endpoint": "search", "arg": "q", "json": {"results": "none"}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "non-object results are skipped", "endpoint": "search", "arg": "q", "json": {"results": [1, "x", null, [], true, {"title": "kept"}]}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "kept", "url": "", "snippet": "", "description": null, "published_at": null, "acquired_at": null}]}},
    {"name": "mistyped result fields", "endpoint": "search", "arg": "q", "json": {"results": [{"title": 42, "url": {"href": "u"}, "snippet": true, "description": 5, "published_at": ["2024"], "acquired_at": false}]}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "", "url": "", "snippet": "", "description": null, "published_at": null, "acquired_at": null}]}},
    {"name": "null result fields", "endpoint": "search", "arg": "q", "json": {"results": [{"title": null, "url": null, "snippet": null, "description": null}]}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "", "url": "", "snippet": "", "description": null, "published_at": null, "acquired_at": null}]}},
    {"name": "zero and false result fields", "endpoint": "search", "arg": "q", "json": {"results": [{"title": 0, "url": false, "snippet": 0}]}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "", "url": "", "snippet": "", "description": null, "published_at": null, "acquired_at": null}]}},
    {"name": "blank strings are kept in required fields and dropped in optional ones", "endpoint": "search", "arg": "q", "json": {"results": [{"title": "  ", "url": "", "snippet": " ", "description": "  ", "published_at": "", "acquired_at": " "}]}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "  ", "url": "", "snippet": " ", "description": null, "published_at": null, "acquired_at": null}]}},
    {"name": "a different query echo is kept", "endpoint": "search", "arg": "q", "json": {"query": "normalized q"}, "expect": {"query": "normalized q", "mode": null, "request_id": null, "results": []}},
    {"name": "a blank query echo keeps the query sent", "endpoint": "search", "arg": "q", "json": {"query": "  "}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "a numeric query echo keeps the query sent", "endpoint": "search", "arg": "q", "json": {"query": 5}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "a mistyped mode is null", "endpoint": "search", "arg": "q", "json": {"mode": 5}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "an empty mode is null", "endpoint": "search", "arg": "q", "json": {"mode": ""}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "the body's request id over the header's", "endpoint": "search", "arg": "q", "headers": {"X-Request-Id": "hdr"}, "json": {"request_id": "body"}, "expect": {"query": "q", "mode": null, "request_id": "body", "results": []}},
    {"name": "the header's request id, trimmed", "endpoint": "search", "arg": "q", "headers": {"X-Request-Id": "  hdr  "}, "json": {"request_id": " "}, "expect": {"query": "q", "mode": null, "request_id": "hdr", "results": []}},
    {"name": "a numeric body request id falls back to the header", "endpoint": "search", "arg": "q", "headers": {"X-Request-Id": "hdr"}, "json": {"request_id": 9}, "expect": {"query": "q", "mode": null, "request_id": "hdr", "results": []}},
    {"name": "a blank header request id is none", "endpoint": "search", "arg": "q", "headers": {"X-Request-Id": "  "}, "json": {}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "a 201 is a success", "endpoint": "search", "arg": "q", "status": 201, "json": {"results": []}, "expect": {"query": "q", "mode": null, "request_id": null, "results": []}},
    {"name": "a leading byte order mark is ignored", "endpoint": "search", "arg": "q", "body": "﻿{\"results\":[{\"title\":\"T\",\"url\":\"u\",\"snippet\":\"s\"}]}", "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "T", "url": "u", "snippet": "s", "description": null, "published_at": null, "acquired_at": null}]}},
    {"name": "an overflowing number in an extra field is not an error", "endpoint": "search", "arg": "q", "body": "{\"results\":[{\"title\":\"T\",\"url\":\"u\",\"snippet\":\"s\",\"score\":1e400}],\"took\":1e400}", "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "T", "url": "u", "snippet": "s", "description": null, "published_at": null, "acquired_at": null}]}},
    {"name": "a JSON array body", "endpoint": "search", "arg": "q", "body": "[]", "expect": {"error": "api"}},
    {"name": "a JSON string body", "endpoint": "search", "arg": "q", "body": "\"ok\"", "expect": {"error": "api"}},
    {"name": "a JSON null body", "endpoint": "search", "arg": "q", "body": "null", "expect": {"error": "api"}},
    {"name": "an empty body", "endpoint": "search", "arg": "q", "body": "", "expect": {"error": "api"}},
    {"name": "a 204", "endpoint": "search", "arg": "q", "status": 204, "body": "", "expect": {"error": "api"}},
    {"name": "an HTML body", "endpoint": "search", "arg": "q", "body": "<html>ok</html>", "expect": {"error": "api"}},
    {"name": "a NaN literal is not JSON", "endpoint": "search", "arg": "q", "body": "{\"results\":[],\"score\":NaN}", "expect": {"error": "api"}},
    {"name": "trailing data is not JSON", "endpoint": "search", "arg": "q", "body": "{\"results\":[]}{}", "expect": {"error": "api"}},
    {"name": "a full page", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"url": "https://e.com/final", "title": "T", "content": "C", "description": "D", "author": "A", "published_at": "2024-01-01"}, "expect": {"url": "https://e.com/final", "title": "T", "content": "C", "description": "D", "author": "A", "published_at": "2024-01-01", "request_id": null}},
    {"name": "an empty page", "endpoint": "fetch", "arg": "https://e.com/p", "json": {}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a blank page url falls back", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"url": "  "}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "an empty page url falls back", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"url": ""}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a numeric page url falls back", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"url": 5}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "mistyped page fields", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"title": 5, "content": ["x"], "description": {}, "author": 1, "published_at": true}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a page request id from the header", "endpoint": "fetch", "arg": "https://e.com/p", "headers": {"X-Request-Id": "hdr"}, "json": {"content": "C"}, "expect": {"url": "https://e.com/p", "title": "", "content": "C", "description": null, "author": null, "published_at": null, "request_id": "hdr"}},
    {"name": "a page body that is an array", "endpoint": "fetch", "arg": "https://e.com/p", "body": "[{\"content\":\"C\"}]", "expect": {"error": "api"}},
    {"name": "a page date as an ISO string is kept", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": "2024-05-01T12:00:00Z"}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": "2024-05-01T12:00:00Z", "request_id": null}},
    {"name": "a page date in Unix seconds is ISO 8601 UTC", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": 1714564800}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": "2024-05-01T12:00:00Z", "request_id": null}},
    {"name": "a page date in fractional seconds drops the fraction", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": 1714564800.75}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": "2024-05-01T12:00:00Z", "request_id": null}},
    {"name": "a page date of 1 second is the epoch's first second", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": 1}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": "1970-01-01T00:00:01Z", "request_id": null}},
    {"name": "a page date of 0 is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": 0}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a page date of half a second is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": 0.5}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a negative page date is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": -1}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "the last second of 9999 is kept", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": 253402300799}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": "9999-12-31T23:59:59Z", "request_id": null}},
    {"name": "a page date past 9999 is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": 253402300800}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a page date in milliseconds is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": 1714564800000}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a huge page date is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": 1e+20}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "an overflowing page date is unset", "endpoint": "fetch", "arg": "https://e.com/p", "body": "{\"published_at\":1e400}", "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a page date as a numeric string is kept as sent", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": "1714564800"}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": "1714564800", "request_id": null}},
    {"name": "a null page date is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": null}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a page date of false is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"published_at": false}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a truncated page", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"content": "abc...", "truncated": true, "total_chars": 120000}, "expect": {"url": "https://e.com/p", "title": "", "content": "abc...", "description": null, "author": null, "published_at": null, "request_id": null, "truncated": true, "total_chars": 120000}},
    {"name": "a page that was not cut", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"content": "", "truncated": false, "total_chars": 0}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null, "truncated": false, "total_chars": 0}},
    {"name": "a whole-number float total_chars is kept", "endpoint": "fetch", "arg": "https://e.com/p", "body": "{\"total_chars\":5.0}", "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null, "total_chars": 5}},
    {"name": "the largest safe total_chars is kept", "endpoint": "fetch", "arg": "https://e.com/p", "body": "{\"total_chars\":9007199254740991}", "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null, "total_chars": 9007199254740991}},
    {"name": "total_chars past 2^53 - 1 is unset", "endpoint": "fetch", "arg": "https://e.com/p", "body": "{\"total_chars\":9007199254740992}", "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "mistyped truncated and total_chars are unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"truncated": "true", "total_chars": "10"}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "numeric truncated and boolean total_chars are unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"truncated": 1, "total_chars": true}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a negative total_chars is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"total_chars": -1}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "a fractional total_chars is unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"total_chars": 1.5}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "an overflowing total_chars is unset", "endpoint": "fetch", "arg": "https://e.com/p", "body": "{\"truncated\":true,\"total_chars\":1e400}", "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null, "truncated": true}},
    {"name": "null truncated and total_chars are unset", "endpoint": "fetch", "arg": "https://e.com/p", "json": {"truncated": null, "total_chars": null}, "expect": {"url": "https://e.com/p", "title": "", "content": "", "description": null, "author": null, "published_at": null, "request_id": null}},
    {"name": "result dates as ISO strings are kept", "endpoint": "search", "arg": "q", "json": {"results": [{"title": "T", "url": "u", "snippet": "s", "published_at": "2024-05-01T12:00:00Z", "acquired_at": "2024-05-02T00:00:00Z"}]}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "T", "url": "u", "snippet": "s", "description": null, "published_at": "2024-05-01T12:00:00Z", "acquired_at": "2024-05-02T00:00:00Z"}]}},
    {"name": "result dates in Unix seconds are ISO 8601 UTC", "endpoint": "search", "arg": "q", "json": {"results": [{"title": "T", "url": "u", "snippet": "s", "published_at": 1714564800, "acquired_at": 1714608000.5}]}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "T", "url": "u", "snippet": "s", "description": null, "published_at": "2024-05-01T12:00:00Z", "acquired_at": "2024-05-02T00:00:00Z"}]}},
    {"name": "out-of-range result dates are unset", "endpoint": "search", "arg": "q", "json": {"results": [{"title": "T", "url": "u", "snippet": "s", "published_at": -1, "acquired_at": 1e+20}]}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "T", "url": "u", "snippet": "s", "description": null, "published_at": null, "acquired_at": null}]}},
    {"name": "zero and numeric-string result dates", "endpoint": "search", "arg": "q", "json": {"results": [{"title": "T", "url": "u", "snippet": "s", "published_at": 0, "acquired_at": "1714564800"}]}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [{"title": "T", "url": "u", "snippet": "s", "description": null, "published_at": null, "acquired_at": "1714564800"}]}}
  ]
}
