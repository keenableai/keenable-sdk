    {"name": "a usage money field that is not an object is null, the rest is kept", "endpoint": "search", "arg": "q", "json": {"query": "q", "results": [], "usage": {"sku": "search.pro", "amount": 1, "credits": 1, "paid": true, "credits_remaining": 5, "cost": "0.004", "balance": [0.004]}}, "expect": {"query": "q", "mode": null, "request_id": null, "results": [], "usage": {"items": [{"sku": "search.pro", "quantity": 1, "price": {"amount": "0", "currency": "usd"}}], "total": {"amount": "0", "currency": "usd"}, "balance": null, "sku": "search.pro", "amount": 1, "credits": 1, "paid": true, "credits_remaining": 5}}},
