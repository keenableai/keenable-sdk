    {"name": "a fractional total_chars is unset", "urls": ["https://e.com/p"], "json": {"results": [{"total_chars": 1.5}]}, "expect": {"request_id": null, "results": [{"url": "https://e.com/p", "page": {"url": "https://e.com/p"}}]}},
